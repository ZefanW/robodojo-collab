{
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "algorithm",
    "protocol",
    "scene",
    "attempt",
    "environment",
    "status",
    "timestamps",
    "outcome",
    "costs",
    "artifacts",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$"
    },
    "algorithm": {
      "type": "object",
      "required": [
        "algorithm_id",
        "version",
        "source_commit",
        "prompt_sha256",
        "tools_sha256",
        "policy_sha256",
        "model",
        "reasoning_effort",
        "codex_client_version"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "tools_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "codex_client_version": {
          "type": "string"
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "id",
        "version",
        "scope",
        "action_limit",
        "episode_control_limit",
        "selection_policy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "action_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "episode_control_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "selection_policy": {
          "type": "string"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "task",
        "capability",
        "variant",
        "official_seed",
        "layout_ordinal",
        "asset_path",
        "asset_sha256",
        "round_index"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "capability": {
          "enum": [
            "Generalization",
            "Memory",
            "Precision",
            "Long-Horizon",
            "Open"
          ]
        },
        "variant": {
          "enum": [
            "standard",
            "random"
          ]
        },
        "official_seed": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "layout_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "asset_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"
        },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "round_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "index",
        "contributor_id",
        "reason",
        "repeats_run_id"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "contributor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$"
        },
        "reason": {
          "type": "string"
        },
        "repeats_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "simulator_version",
        "machine_id",
        "gpu",
        "driver",
        "os",
        "dependencies"
      ],
      "properties": {
        "simulator_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "object"
        }
      }
    },
    "status": {
      "enum": [
        "queued",
        "initializing",
        "running",
        "paused",
        "failed",
        "complete",
        "invalid"
      ]
    },
    "timestamps": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "native_result",
        "episode_complete",
        "score",
        "score_scale",
        "success",
        "control_steps",
        "model_decisions",
        "actual_responses",
        "unstable_envs",
        "evidence_consistent"
      ],
      "properties": {
        "native_result": {
          "type": "boolean"
        },
        "episode_complete": {
          "type": "boolean"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "score_scale": {
          "const": "0..1"
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "control_steps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_decisions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actual_responses": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unstable_envs": {
          "type": "array"
        },
        "evidence_consistent": {
          "type": "boolean"
        }
      }
    },
    "costs": {
      "type": "object",
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt_id",
              "input_tokens",
              "cached_input_tokens",
              "output_tokens",
              "model_responses",
              "paid_requests",
              "usage_known"
            ],
            "properties": {
              "attempt_id": {
                "type": "string"
              },
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "model_responses": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "paid_requests": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "usage_known": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "sha256",
          "bytes",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "native_result",
              "episode_complete",
              "trajectory",
              "native_ack",
              "public_session",
              "public_timeline",
              "original_image",
              "native_video",
              "public_demo",
              "environment",
              "source_lock",
              "costs",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          },
          "view": {
            "type": "string"
          },
          "storage": {
            "type": "object",
            "required": [
              "provider",
              "landing_url"
            ],
            "properties": {
              "provider": {
                "const": "tsinghua"
              },
              "landing_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "download_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "playback_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remote_relative_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verification": {
                "enum": [
                  "local_sha256",
                  "remote_sha256",
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "session_public_id",
        "export_policy",
        "redactions",
        "limitations"
      ],
      "properties": {
        "session_public_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "export_policy": {
          "type": "string"
        },
        "redactions": {
          "type": "array"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "provider",
        "landing_url"
      ],
      "properties": {
        "provider": {
          "const": "tsinghua"
        },
        "landing_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "download_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "playback_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_relative_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "enum": [
            "local_sha256",
            "remote_sha256",
            "none"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoboDojo public run manifest v1.0",
  "description": "Structural schema. CLI additionally verifies privacy, native completion evidence requirements, SHA bytes, cost cache subsets and seed semantics. Unknown measurements are null, never fabricated zero.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "native_result": {
                "const": true
              },
              "episode_complete": {
                "const": true
              },
              "evidence_consistent": {
                "const": true
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "success": {
                "type": "boolean"
              },
              "control_steps": {
                "type": "integer",
                "minimum": 0
              },
              "unstable_envs": {
                "maxItems": 0
              }
            }
          },
          "costs": {
            "properties": {
              "attempts": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
